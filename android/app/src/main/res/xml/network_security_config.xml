<?xml version="1.0" encoding="utf-8"?>
<!-- CertVault usually lives on your home network (http://192.168.x.x) or Tailscale, so plain HTTP is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
