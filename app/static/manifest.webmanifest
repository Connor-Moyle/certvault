{
  "name": "CertVault",
  "short_name": "CertVault",
  "description": "Licences, tickets and inductions with expiry reminders",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f9f9ff",
  "theme_color": "#415f91",
  "icons": [
    { "src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/static/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/static/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add document", "url": "/#/add", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] }
  ]
}
